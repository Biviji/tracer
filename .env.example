# Copy to .env and fill in. Never commit the real .env.
# With no .env at all, TRACE runs fully offline: fake AI model + simulated sandboxes.

# ---------- frontend ----------
# Base URL of the orchestrator as seen from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000
# true  -> frontend runs against an in-browser mock (no backend needed)
# false -> frontend calls the real orchestrator at NEXT_PUBLIC_API_URL
NEXT_PUBLIC_USE_MOCK=true

# ---------- orchestrator: AI model ----------
# fake              -> offline scripted replies, no key needed
# openai_compatible -> any OpenAI-style API. Switching provider = changing the 3 lines below.
# The hackathon setup uses Vultr Serverless Inference (the default URL below).
LLM_PROVIDER=fake
#   Vultr Serverless Inference: https://api.vultrinference.com/v1
#   OpenAI:                     https://api.openai.com/v1
#   OpenRouter:                 https://openrouter.ai/api/v1
#   Groq:                       https://api.groq.com/openai/v1
#   Ollama (local):             http://localhost:11434/v1
LLM_BASE_URL=https://api.vultrinference.com/v1
# Vultr: console > Serverless Inference > (your subscription) > API Key
LLM_API_KEY=
# Comma-separated model ids; each becomes an agent in the UI. They must support tool calls.
# Tool-capable on Vultr Serverless Inference (checked 2026-11-05): glm-5.3, glm-5.2, glm-5.3-flash,
# deepseek-v4.1-flash-1017, qwen3.8-27b, qwen3.8-flash-next, minimax-m3.1-flash, mimo-v2.6-pro, mimo-v2.6-flash
LLM_MODELS=qwen3.8-27b,glm-5.3,deepseek-v4.1-flash-1017,minimax-m3.1-flash
# Check the model works:  cd orchestrator && python -m app.llm.check

# ---------- orchestrator: sandboxes ----------
# sim    -> simulated runs, no Docker, no AI calls (scripted results)
# docker -> real runs: one locked-down container per run (build: docker build -t trace-sandbox:latest runner/)
SANDBOX_DRIVER=sim
MAX_RUNS=10
MAX_PARALLEL_SANDBOXES=4
# Hard wall-clock cap per run. Free model tiers rate-limit hard (Groq: 8000 tokens/min),
# so real runs spend time waiting; use ~900 there.
SANDBOX_TIMEOUT_S=300
SANDBOX_MEMORY_MB=1024
SANDBOX_CPUS=1
# Agent tool calls per run before it must answer; per-command time cap inside the sandbox
AGENT_MAX_STEPS=40
COMMAND_TIMEOUT_S=60
# Linux VM only: group id that owns /var/run/docker.sock  ->  stat -c %g /var/run/docker.sock
# DOCKER_GID=999

# ---------- orchestrator: storage ----------
# SQLite for MVP; swap for Vultr Managed Postgres later (postgresql+psycopg://...)
DB_URL=sqlite:///./trace.db

# ---------- Vultr control plane (later: managed DB, per-run VMs) ----------
# Orchestrator only — never shipped to the browser or sandboxes.
VULTR_API_KEY=

# ---------- production server only (docker-compose.prod.yml, see deploy/README.md) ----------
# Public address Caddy serves with HTTPS: a domain, or <ip-with-dashes>.sslip.io
SITE_ADDRESS=
BASIC_AUTH_USER=trace
# bcrypt hash of the site password, in SINGLE quotes:
#   docker run --rm caddy:2.8.4 caddy hash-password --plaintext 'your-password'
BASIC_AUTH_HASH=
