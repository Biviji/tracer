# Copy to .env and fill in. Never commit the real .env.

# ---------- frontend ----------
# Base URL of the orchestrator as seen from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000
# true  -> frontend runs against an in-browser mock (no backend needed)
# false -> frontend calls the real orchestrator at NEXT_PUBLIC_API_URL
NEXT_PUBLIC_USE_MOCK=true

# ---------- orchestrator (coming next) ----------
# Vultr API key (control plane: instances, managed DB). Orchestrator only — never shipped to the browser or sandboxes.
VULTR_API_KEY=
# Vultr Serverless Inference (OpenAI-compatible endpoint) + key
VULTR_INFERENCE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_API_KEY=
# SQLite for MVP; swap for Vultr Managed Postgres later
DB_URL=sqlite:///./trace.db
