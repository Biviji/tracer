# Copy to .env.local for local development.

# true  -> in-browser mock backend, no orchestrator needed
# false -> real orchestrator behind /api
NEXT_PUBLIC_USE_MOCK=true

# Browser-side API base. Keep "/api" so requests go through the Next proxy below.
NEXT_PUBLIC_API_URL=/api

# Where the Next server forwards /api/* (server-side only, never sent to the browser).
ORCHESTRATOR_URL=http://localhost:8000
