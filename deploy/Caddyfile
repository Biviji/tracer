# Public entry point on the VM: automatic HTTPS in front of the app. The site is open (no
# login); spending is capped by MAX_RUNS_PER_HOUR in the orchestrator. The orchestrator and
# sandboxes are never exposed; the browser reaches the API via the frontend's /api proxy.
# Caddy streams SSE (the live view) without buffering by default.
{$SITE_ADDRESS} {
	reverse_proxy frontend:3000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
}
